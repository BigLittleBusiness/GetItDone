# ─── TaskBloom — Environment Variables ───────────────────────────────────────
#
# Copy this file to .env and fill in the values before running docker compose.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets to the repository.
# See docs/local-development.md for a full setup walkthrough.
#
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# Used by docker-compose to initialise the MySQL container.
# The DATABASE_URL is assembled automatically from these values inside
# docker-compose.yml — you do not need to set DATABASE_URL manually for local dev.

DB_ROOT_PASSWORD=rootpassword
DB_NAME=taskbloom
DB_USER=taskbloom
DB_PASSWORD=taskbloom_dev


# ── Session & Admin ───────────────────────────────────────────────────────────
# JWT_SECRET: used to sign session cookies. Must be at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=replace_with_a_32_char_random_secret

# ADMIN_PASSWORD: password for the /admin dashboard.
# Use a strong, unique password — this account has full data access.

ADMIN_PASSWORD=replace_with_a_strong_password


# ── Manus OAuth ───────────────────────────────────────────────────────────────
# Required for the user login flow.
# Obtain these from your Manus project settings at https://manus.im
# For UI-only local development (no login), you can leave these as placeholders.

VITE_APP_ID=your_manus_app_id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# Owner identity — used for owner notifications.
OWNER_OPEN_ID=your_manus_open_id
OWNER_NAME=Your Name


# ── Manus Built-in APIs (LLM, Storage, Notifications) ────────────────────────
# Required for AI task expansion, voice transcription, file uploads, and
# owner notifications. Obtain from your Manus project settings.
# Leave blank to disable these features during local development.

BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Frontend-accessible Forge API (used by the React client directly).
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=


# ── Analytics (optional) ──────────────────────────────────────────────────────
# Leave blank to disable analytics tracking in local development.

VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
