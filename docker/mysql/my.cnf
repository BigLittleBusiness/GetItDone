# ─── TaskBloom — Local MySQL 8 Configuration ─────────────────────────────────
#
# Mounted read-only into the MySQL container by docker-compose.yml at:
#   /etc/mysql/conf.d/taskbloom.cnf
#
# Goal: make the local database behave as closely as possible to the production
# TiDB/MySQL environment so that query plans, index usage, and transaction
# behaviour are consistent between local development and production.
#
# All values are sized for a developer laptop (8 GB RAM assumed).
# Adjust innodb_buffer_pool_size if your machine has significantly more or less
# RAM — a good rule of thumb is 50-70 % of available RAM for a dedicated DB.
#
# ─────────────────────────────────────────────────────────────────────────────

[mysqld]

# ── Character Set & Collation ─────────────────────────────────────────────────
# Match the production TiDB default. utf8mb4 supports the full Unicode range
# (including emoji); utf8mb4_unicode_ci provides correct case-insensitive
# sorting for all languages.
character-set-server          = utf8mb4
collation-server              = utf8mb4_unicode_ci
init_connect                  = 'SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci'

# ── InnoDB Storage Engine ─────────────────────────────────────────────────────
# innodb_buffer_pool_size: the single most impactful setting.
# 1 GB is appropriate for a developer laptop; increase to 2-4 GB on machines
# with 16+ GB RAM.
innodb_buffer_pool_size       = 1G

# Use multiple buffer pool instances to reduce contention on multi-core machines.
# Recommended: 1 instance per GB of buffer pool, up to 8.
innodb_buffer_pool_instances  = 2

# Flush method: O_DIRECT bypasses the OS page cache for InnoDB data files,
# avoiding double-buffering and making memory usage predictable.
innodb_flush_method           = O_DIRECT

# Flush log at each transaction commit (1 = fully ACID-compliant, matches prod).
# Set to 2 for faster local writes at the cost of up to 1 second of data loss
# on an unclean shutdown — acceptable for local dev if you prefer speed.
innodb_flush_log_at_trx_commit = 1

# Log file size: larger files reduce checkpoint frequency and improve write
# throughput for bulk operations (migrations, seeding).
innodb_log_file_size          = 256M

# Enable per-table file-per-table tablespaces so individual tables can be
# inspected, copied, or dropped without affecting others.
innodb_file_per_table         = ON

# ── Query & Execution ─────────────────────────────────────────────────────────
# Strict SQL mode: matches the production default and catches data truncation,
# invalid dates, and division-by-zero at query time rather than silently.
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# Maximum allowed packet size for large JSON payloads and TEXT columns.
max_allowed_packet            = 64M

# ── Connection Pool ───────────────────────────────────────────────────────────
# max_connections: 50 is more than enough for local dev (the app pool uses ~5).
# Keeping this low prevents the container from allocating memory for idle threads.
max_connections               = 50

# Thread cache: reuse threads for short-lived connections instead of spawning
# new OS threads on each connect.
thread_cache_size             = 10

# ── Slow Query Log ────────────────────────────────────────────────────────────
# Enabled so that queries slower than 1 second are logged to the container
# stdout (via the general_log_file path below).  This surfaces N+1 query
# patterns and missing indexes during development before they reach production.
slow_query_log                = ON
slow_query_log_file           = /var/lib/mysql/slow.log
long_query_time               = 1
log_queries_not_using_indexes = ON
min_examined_row_limit        = 100

# ── Binary Log (disabled for local dev) ──────────────────────────────────────
# Binary logging is required for replication and point-in-time recovery in
# production but adds overhead locally. Disable it to speed up writes.
skip-log-bin

# ── Timezone ─────────────────────────────────────────────────────────────────
# Store and compare all timestamps in UTC, matching the application's
# convention of persisting UTC Unix timestamps.
default-time-zone             = '+00:00'

# ── Performance Schema (lightweight) ─────────────────────────────────────────
# Keep the performance schema enabled (it is on by default in MySQL 8) but
# reduce the number of instruments to lower memory overhead on a laptop.
performance_schema                                    = ON
performance_schema_max_table_instances               = 400
performance_schema_max_file_instances                = 400
performance_schema_events_waits_history_long_size    = 1000

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
